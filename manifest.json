{
  "manifest_version": 3,
  "name": "Forum Read Addon",
  "version": "0.2.21",
  "description": "Lee automáticamente los posts de un hilo vBulletin",
  "action": {
    "default_title": "Forum Read",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "images/icon/icons8-audio-book-48.png"
    }
  },
  "icons": {
    "48": "images/icon/icons8-audio-book-48.png"
  },
  "permissions": ["activeTab", "tabs", "contextMenus", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sounds/*.mp3"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "next-post": {
      "suggested_key": {
        "default": "F4"
      },
      "description": "Saltar al siguiente comentario"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "forum-read-addon-private-20260411@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
